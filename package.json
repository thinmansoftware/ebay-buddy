{
  "name": "@thinmansoftware/ebay-buddy-core",
  "version": "0.1.0-rc.10",
  "private": true,
  "description": "eBay listing search plus optional on-demand, read-only Gmail sale-notice briefs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ebay-buddy": "dist/browse-core/cli.js"
  },
  "exports": {
    ".": "./dist/browse-core/runtime.js",
    "./http": "./dist/browse-core/http.js",
    "./mcp": "./dist/browse-core/mcp.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "PUBLICATION_GATES.md",
    "ROADMAP.md",
    "GROK_SETUP.md",
    "CLIENT_SETUP.md",
    "THIRD_PARTY_NOTICES.txt",
    "dependency-inventory.json",
    "sbom.cdx.json",
    "npm-shrinkwrap.json",
    "GMAIL_WORKFLOW.md",
    "PRIVACY.md",
    "SUPPORT.md",
    "plugin.json",
    "GROK_ACCEPTANCE.md",
    "companion/mail_watch.py",
    "companion/render_brief.py",
    "skills/ebay-mail-watch/SKILL.md",
    "assets/icon.svg",
    "companion/rank_search.py",
    "companion/cli.py",
    "scripts/check-prerequisites.mjs",
    "mcp.template.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "lint": "eslint .",
    "check": "node scripts/check-prerequisites.mjs",
    "pretest": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "zod": "4.6.7",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
